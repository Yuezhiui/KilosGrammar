[sub_resource type="Shader" id="Shader_mask"]
code = "shader_type canvas_item;\nrender_mode unshaded;\nuniform vec2 hole_center = vec2(0.5, 0.5);\nuniform vec2 hole_half_size = vec2(0.15, 0.12);\nuniform float hole_roundness = 0.02;\nuniform float hole_feather = 0.004;\nvoid fragment() {\n  vec2 delta = abs(UV - hole_center) - hole_half_size + vec2(hole_roundness);\n  float sd = length(max(delta, vec2(0.0))) + min(max(delta.x, delta.y), 0.0) - hole_roundness;\n  float outside = smoothstep(0.0, max(0.00001, hole_feather), sd);\n  COLOR = vec4(0.012, 0.014, 0.058, 0.70 * outside);\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_mask"]
