[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/secondary/leaderboard.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/secondary/secondary_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="Card"]
bg_color = Color(1, 0.968627, 0.862745, 0.88)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
