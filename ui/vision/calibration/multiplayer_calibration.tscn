[sub_resource type="Shader" id="WoodenFrameTransparentCenter"]
code = "shader_type canvas_item;
void fragment() {
    vec4 pixel = texture(TEXTURE, UV);
    float brightness = max(pixel.r, max(pixel.g, pixel.b));
    pixel.a *= smoothstep(0.04, 0.14, brightness);
    COLOR = pixel;
}"

[sub_resource type="ShaderMaterial" id="WoodenFrameMaterial"]
shader = SubResource("WoodenFrameTransparentCenter")

