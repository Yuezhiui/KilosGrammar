[sub_resource type="Shader" id="V2BlackInteriorTransparent"]
code = "shader_type canvas_item;
void fragment() {
    vec4 sample_color = texture(TEXTURE, UV);
    float brightness = max(sample_color.r, max(sample_color.g, sample_color.b));
    sample_color.a *= smoothstep(0.04, 0.14, brightness);
    COLOR = sample_color;
}
"

[sub_resource type="ShaderMaterial" id="V2FrameOverlayMaterial"]
shader = SubResource("V2BlackInteriorTransparent")

[sub_resource type="Shader" id="V2CountdownOriginalTransparency"]
code = "shader_type canvas_item;
uniform sampler2D silhouette_mask : repeat_disable, filter_linear;
void fragment() {
    vec4 badge = texture(TEXTURE, UV);
    badge.a *= texture(silhouette_mask, UV).a;
    COLOR = badge;
}
"

[sub_resource type="ShaderMaterial" id="V2CountdownMaterial"]
shader = SubResource("V2CountdownOriginalTransparency")
shader_parameter/silhouette_mask = ExtResource("19_v2_count3")

[sub_resource type="StyleBoxEmpty" id="TransparentArtButton"]

