[node name="SkeletonPlacement" type="ReferenceRect" parent="TutorialStage" unique_id=1271269511]
editor_description = "EDIT GREEN YOLO BONES HERE: drag or resize this rectangle in the Godot 2D editor (or Inspector > Transform). By default it matches LiveCameraInset exactly. The green skeleton follows actual detected body joints; changing this independent box offsets/scales the DRAWING only, so keep it aligned with the camera for accurate tracking. The reference border is editor-only, never visible to students. Restart the camera after editing."
