[sub_resource type="Shader" id="CatchTutorialCutoutShader"]
code = "shader_type canvas_item;
uniform vec4 focus_rect = vec4(0.1, 0.1, 0.4, 0.2);
uniform float dim_alpha : hint_range(0.0, 1.0) = 0.77;
void fragment() {
    bool lit = UV.x >= focus_rect.x && UV.x <= focus_rect.x + focus_rect.z && UV.y >= focus_rect.y && UV.y <= focus_rect.y + focus_rect.w;
    COLOR = vec4(0.02, 0.015, 0.09, lit ? 0.0 : dim_alpha);
}
"

[sub_resource type="ShaderMaterial" id="CatchTutorialCutoutMaterial"]
shader = SubResource("CatchTutorialCutoutShader")
shader_parameter/focus_rect = Vector4(0.1, 0.1, 0.4, 0.2)
shader_parameter/dim_alpha = 0.77

