[sub_resource type="Shader" id="BalloonTutorialCutoutShader"]
code = "shader_type canvas_item;\nuniform vec4 focus_rect = vec4(0.1, 0.1, 0.4, 0.2);\nuniform float dim_alpha : hint_range(0.0, 1.0) = 0.77;\nvoid fragment() {\n    bool lit = UV.x >= focus_rect.x && UV.x <= focus_rect.x + focus_rect.z && UV.y >= focus_rect.y && UV.y <= focus_rect.y + focus_rect.w;\n    COLOR = vec4(0.02, 0.015, 0.09, lit ? 0.0 : dim_alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="BalloonTutorialCutoutMaterial"]
shader = SubResource("BalloonTutorialCutoutShader")

