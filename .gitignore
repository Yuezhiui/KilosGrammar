# Godot 4+ specific ignores
.godot/
/android/

# Locally generated graphical QA and screenshots (not runtime assets).
/showcase/

# The local music override is a commercially released soundtrack.
# Keep the user's local copy for testing, but do not publish it without
# distribution rights. The menu handles a missing override gracefully.
/assets/audio/user_provided/*.mp3
/assets/audio/user_provided/*.mp3.import

# Python runtime bytecode and isolated Godot QA import probes.
__pycache__/
*.pyc
ui/redesign/assets/.qa_*.jpg.import

# The retired Human Plane 3D source and models are no longer project assets.
# Do not re-introduce them to the 2D-only game or to exported resources.
