# Godot 4+ specific ignores
.godot/
/android/

# Locally generated graphical QA and screenshots (not runtime assets).
/showcase/

# The local music override is a commercially released soundtrack.
# Keep the user's local copy for testing, but do not publish it without
# distribution rights. The menu handles a missing override gracefully.
/assets/audio/user_provided/*.mp3
/assets/audio/user_provided/*.mp3.import

# Python runtime bytecode and isolated Godot QA import probes.
__pycache__/
*.pyc
ui/redesign/assets/.qa_*.jpg.import

# Unverified/private source models: keep local Godot user art, never publish.
/Components/Gameplay/Human Plane/3D/red-plane/
/Components/Gameplay/Human Plane/3D/mountain/
/Components/Gameplay/Human Plane/3D/grass-green/
/Components/Gameplay/Human Plane/3D/pbr/
/Components/Gameplay/Human Plane/3D/*.fbx
/Components/Gameplay/Human Plane/3D/*.fbx.import
/Components/Gameplay/Human Plane/3D/Skybox/textures/clouds_anime_6k.jpg
/Components/Gameplay/Human Plane/3D/Skybox/textures/clouds_anime_6k.jpg.import
/ui/minigames/human_plane_3d_foliage.gd*
/ui/minigames/human_plane_3d_mountains.gd*
